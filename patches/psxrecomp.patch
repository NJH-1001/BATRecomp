+void jump_table_bound_uses_index() {
+    std::vector<uint32_t> words(40, 0);
+    const std::vector<uint32_t> code = {
+        0x1080000Fu, // beq a0,zero,target at +64
+        0u,
+        0x2CC30020u, // sltiu v1,a2,32: unrelated size comparison
+        0x30830003u, // andi v1,a0,3: four possible table indices
+        0x3C090000u, 0x25290580u, // table at RAM 0x580 (ROM +128)
+        0x00035080u, // sll t2,v1,2
+        0x01495021u, // addu t2,t2,t1
+        0x8D490000u, 0u, // lw t1,0(t2); load delay
+        0x01200008u, 0u // jr t1; nop
+    };
+    for (size_t i=0; i<code.size(); ++i) words[i]=code[i];
+    words[16]=0x03E00008u;
+    for (size_t i=32; i<36; ++i) words[i]=0x540u;
+    words[36]=0xAC850024u; // adjacent instructions are not table entries
+    auto result=run_case("masked-index", words,
+        {function_at(kBase, kBase+68u, {kBase, kBase+8u, kBase+64u})});
+    expect(result.body.find("jump table at 0x00000580, 4 entries") != std::string::npos,
+           "table bound is derived from the masked index");
+    expect(result.body.find("32 entries") == std::string::npos,
+           "unrelated SLTIU is not a table bound");
+}
+
+void discovery_always_taken_branch() {
+    // BEQ with identical operands has no fallthrough, but owns its delay slot.
+    // An illegal word after that slot must remain data, while a conditional
+    // BEQ must still diagnose the same word on its reachable fallthrough.
+    for (uint32_t branch : {0x10000003u, 0x11080003u, 0x11090003u}) {
+        std::vector<uint8_t> rom;
+        for (uint32_t word : {branch, 0x24020001u, 0xFFFFFFFFu,
+                              0xFFFFFFFFu, 0x03E00008u, 0u})
+            append_word(rom, word);
+        const auto result = FunctionDiscovery::walk_function(
+            rom, kBase, kBase + 23u, kBase, kBase + 24u, "branch fixture");
+        const bool unconditional = branch != 0x11090003u;
+        expect(result.unsupported.empty() == unconditional,
+               "only reachable illegal instructions fail discovery");
+        bool delay_seen = false;
+        bool target_seen = false;
+        for (const auto& instruction : result.instructions) {
+            delay_seen |= instruction.first == kBase + 4u;
+            target_seen |= instruction.first == kBase + 16u;
+        }
+        expect(delay_seen, "BEQ delay slot is retained");
+        expect(target_seen, "BEQ taken target is retained");
+    }
+}
+
 }  // namespace
 
